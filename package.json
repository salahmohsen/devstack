{
  "name": "tsu-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test:unit:run": "pnpm dotenvx run -f ./packages/env/.env -- vp run -r test:unit",
    "test:e2e:run": "pnpm dotenvx run -f ./packages/env/.env -- vp run -r test:e2e",
    "dev": "pnpm -r --parallel dev",
    "build": "vp run -r build",
    "deploy": "pnpm run deploy:server && pnpm run deploy:web",
    "deploy:server": "vp run --filter @tsu-stack/server deploy",
    "deploy:web": "vp run --filter @tsu-stack/web deploy",
    "logs": "vp run -r --parallel logs",
    "logs:server": "vp run --filter @tsu-stack/server logs",
    "email:dev": "vp run --filter @tsu-stack/email email:dev",
    "logs:web": "vp run --filter @tsu-stack/web logs",
    "prepare": "vp config",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "fallow": "vpx fallow --skip health",
    "tanstack": "vpx @tanstack/cli@latest",
    "db": "vp run --filter @tsu-stack/db db",
    "db:push": "vp run -w db push",
    "db:generate": "vp run -w db generate",
    "db:migrate": "vp run -w db migrate",
    "db:setup": "vp run --filter @tsu-stack/db db:setup && vp run db:migrate",
    "db:studio": "vp run -w db studio",
    "mastra:dev": "mastra studio --port 4111 --server-host localhost --server-port 5001",
    "mastra:deploy": "mastra studio deploy --yes --skip-preflight --env-file packages/env/.env",
    "docker:up": "pnpm dotenvx run -f .env.docker docker -- compose up",
    "docker:up:build": "pnpm dotenvx run -f .env.docker docker -- compose up --build",
    "docker:down": "pnpm dotenvx run -f .env.docker docker -- compose down",
    "ui": "vp run --filter @tsu-stack/ui ui",
    "ui:web": "vp run --filter @tsu-stack/web ui",
    "auth:secret": "npx auth@latest secret",
    "auth:generate": "pnpm --filter @tsu-stack/db run auth:generate",
    "cf-typegen": "vp run --filter @tsu-stack/server cf-typegen"
  },
  "dependencies": {
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint-plugin-fsd-lint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "mastra": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.8.0"
}
