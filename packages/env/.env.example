# ============================================================
# Shared
# ============================================================

# Public URL of the API server (no path suffix — app mounts at URL root).
# Production (Dokploy): https://api.your.domain
# Local: http://localhost:5200 (or :5100 in docker-compose.local)
# Browser-facing API (OAuth callbacks, oRPC, session cookies). Keep this on
# localhost for local web — do not point it at the tunnel host or OAuth cookies
# become third-party (state mismatch / failed sign-in).
#
# GitHub/Google OAuth callback: {VITE_SERVER_URL}/auth/callback/github|google
#
# Dokploy: assign domain api.your.domain to the server service and do NOT
# enable "add prefix /server" (that was for the old /server mount).
VITE_SERVER_URL="http://localhost:5200"

# Public URL of the web app (primary app host — dashboard, auth, /{profileName} portfolios)
VITE_WEB_URL="http://localhost:3000"

# ============================================================
# Local public tunnel (scripts/dev.sh — cloudflared CLI only)
# ============================================================
# SaaS webhooks (Resend, Gmail Pub/Sub, GitHub) need a public HTTPS origin.
# Deployment is Dokploy/Docker — not Cloudflare Workers. cloudflared is only
# for local inbound traffic to :5200.
#
# `pnpm dev:tunnel` keeps VITE_SERVER_URL on localhost for OAuth and exposes
# DEV_PUBLIC_SERVER_URL for inbound webhooks only.
#
# Named tunnel + your subdomain (stable — recommended for Gmail):
#   1. brew install cloudflared
#   2. cloudflared tunnel login
#   3. cloudflared tunnel create tsu-stack-dev
#   4. cloudflared tunnel route dns tsu-stack-dev api-dev.example.com
#   5. Copy scripts/cloudflared.tunnel.example.yml → scripts/cloudflared.tunnel.yml
#      and set tunnel UUID + credentials-file + hostname
#   6. Fill the vars below, then: pnpm dev:tunnel
#
# DEV_TUNNEL="1"
# DEV_TUNNEL_MODE="named"   # named | quick (default: named if config/name set)
# DEV_PUBLIC_SERVER_URL="https://api-dev.example.com"
# DEV_CLOUDFLARED_CONFIG="scripts/cloudflared.tunnel.yml"  # gitignored; see scripts/cloudflared.tunnel.example.yml
# # or without a local YAML: DEV_CLOUDFLARED_TUNNEL_NAME="tsu-stack-dev"
# DEV_WEB_URL="http://localhost:3000"   # browser origin; CORS allowlist

# PostgreSQL connection string (app / API only)
# Database name must match POSTGRES_DB (e.g. personal_hub) — not the username.
DATABASE_URL="postgresql://user:password@localhost:5432/personal_hub"

# Mastra agent storage (workflows, memory, observability). Use a separate DB.
# Created by scripts/init-databases.sh on first Postgres volume init, or:
#   docker exec -it tsu-stack-infra-postgres-1 psql -U admin -d personal_hub -c 'CREATE DATABASE mastra_agent;'
# Prod agent service sets POSTGRES_DB=mastra_agent + CREATE_DB=true instead.
MASTRA_DATABASE_URL="postgresql://user:password@localhost:5432/mastra_agent"

# Docker Compose / Dokploy also use discrete fields (server builds DATABASE_URL at runtime).
# Dokploy tips:
# - One flat env list (section headers are comments only).
# - Quote values that contain + / = or start with / (otherwise trailing = is often stripped).
# - POSTGRES_DB is the database name (personal_hub), NOT the username.
# - Postgres only applies POSTGRES_PASSWORD on first volume init; changing it later
#   does not update the role — ALTER USER or recreate the volume.
# - Compose sets POSTGRES_HOST=hub-postgres (not "postgres"): Traefik services join
#   the shared dokploy-network where other stacks also alias "postgres", which
#   causes 28P01 auth failures against the wrong database.
# POSTGRES_USER=personalhub
# POSTGRES_PASSWORD="...special-chars..."
# POSTGRES_DB=personal_hub

# Secret key for Better Auth (min 32 chars). Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# Deploy / build SHA for health + logs (optional).
# Dokploy does not inject this today — Dockerfiles fall back to git rev-parse
# when .git is in the build context. When Dokploy lands DOKPLOY_COMMIT_HASH
# (PR #4007), that is also accepted. Force a value with:
# SOURCE_COMMIT=""

# ============================================================
# Agent / LLM (Mastra) — BYO AI (no platform-paid keys)
# ============================================================
# Self-host / operators supply their own provider keys. Missing keys do not
# break CRUD: detect-stacks falls back without LLM categorize; resume import
# surfaces extract warnings. Do not invent shared cloud keys for all tenants.

# Required for models "deepseek/*" in apps/agent/src/mastra/model-config.ts.
# Get a key from https://platform.deepseek.com/

# Optional — only if model-config uses opencode/* or openai/* providers
# OPENCODE_API_KEY=""
# OPENAI_API_KEY=""

# ============================================================
# Server
# ============================================================

# Agent worker URL (local process or Docker service name)
AGENT_WORKER_URL="http://localhost:4111"

# Gmail Pub/Sub push (optional — Settings Connections startGmailWatch)
# GCP: enable Gmail + Pub/Sub APIs; topic publisher = gmail-api-push@system.gserviceaccount.com
# Push subscription → {public API origin}/webhooks/gmail-push with OIDC (preferred).
# Local named tunnel example:
#   GMAIL_PUSH_OIDC_AUDIENCE="https://api-dev.example.com/webhooks/gmail-push"
# Prod example:
#   GMAIL_PUSH_OIDC_AUDIENCE="https://api.your.domain/webhooks/gmail-push"
GMAIL_PUBSUB_TOPIC=""
# Preferred: full push endpoint URL as OIDC audience (must match subscription audience)
GMAIL_PUSH_OIDC_AUDIENCE=""
# Optional JWT email claim allowlist (push auth service account email)
GMAIL_PUSH_OIDC_EMAIL=""
# Alternate auth: shared Bearer secret (min 16 chars)
GMAIL_PUSH_SHARED_SECRET=""
# Production defaults to requiring auth; set "false" only for local debug without OIDC
GMAIL_PUSH_REQUIRE_AUTH="true"

# Optional OpenAI embeddings for correction few-shot (pgvector)
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Expose the OpenAPI /docs endpoint
ENABLE_OPEN_API_DOCS="false"

# Shared secret for validating GitHub webhooks
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth app credentials
GITHUB_CLIENT_ID="replace-with-your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-your-github-oauth-client-secret"

# Google OAuth (optional) — login/register + Settings → Connections Gmail scopes
# Create OAuth client in Google Cloud Console; authorized redirect:
#   {VITE_SERVER_URL}/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# Axiom (optional) — wide-event drain for @tsu-stack/logger (evlog/axiom).
# AXIOM_API_KEY + AXIOM_DATASET required to enable. Copy from Console ingest snippet:
#   curl -X POST 'https://us-east-1.aws.edge.axiom.co/v1/ingest/<dataset>' \
#     -H 'Authorization: Bearer xaat-...' ...
# Dataset for this app: devhub (Events). Edge URL matches the dataset's edge deployment.
AXIOM_API_KEY="replace-with-your-axiom-api-token"
AXIOM_DATASET="devhub"
AXIOM_EDGE_URL="https://us-east-1.aws.edge.axiom.co"

# BYO Resend — transactional auth/product mail only (optional).
# Unset RESEND_API_KEY to skip sending entirely. Not used for employer apply mail.
RESEND_API_KEY=""

# From address for outgoing email (required when Resend is enabled)
EMAIL_FROM=""

# ============================================================
# S3/MinIO Storage
# ============================================================

# Redis connection string (optional — falls back to redis://localhost:6379).
# Used by: GitHub cache + Socket.IO adapter + Career Inbox classify queue (BullMQ).
# When unset, classify enqueue is a no-op and the classify worker is not started.
# Local docker-compose.infra.yml default password is "changeme":
REDIS_URL="redis://:changeme@localhost:6379"

# Freehire API base URL override (optional — defaults to https://freehire.me/api/v1).
# Used by: per-user job discovery fetch (fail-soft drills / staging).
# FREEHIRE_API_BASE_URL="https://freehire.me/api/v1"

# S3/MinIO endpoint (host 9002 → container 9000; avoids php-fpm on :9000)
S3_ENDPOINT="http://127.0.0.1:9002"

# S3/MinIO credentials — must match docker-compose.infra.yml MINIO_ROOT_* (defaults below)
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# S3 bucket name
S3_BUCKET="personal-hub"

# S3 region
S3_REGION="us-east-1"

# Force path-style S3 URLs (required for MinIO)
S3_FORCE_PATH_STYLE="true"

# Public base URL for files.url(key) (full URL — no ${VAR} interpolation in Dokploy).
# Local MinIO path-style (requires */avatars/* anonymous GetObject from dev.sh / minio-init):
MEDIA_PUBLIC_URL="http://127.0.0.1:9002/personal-hub"
# App proxy alternative (only serves avatars): MEDIA_PUBLIC_URL="$VITE_WEB_URL/api/media"

# ============================================================
# Web
# ============================================================

# HMAC secret for files SDK gateway auth
FILES_API_SECRET="dev-only-secret-do-not-use-in-production"

# Base URL for imgproxy (optional — leave empty to disable)
VITE_IMGPROXY_URL=""
