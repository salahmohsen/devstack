# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL="http://localhost:5000"

# ✅ required - Public URL of the web app.
VITE_WEB_URL="http://localhost:3000"

# ✅ required - Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# ✅ required - Secret key for Better Auth. Generate with: vp run auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# ✅ required at runtime - GitHub OAuth app client ID for Better Auth.
#    Build-time optional (the build can run without it; if missing at runtime,
#    the auth module throws a clear error on first import).
GITHUB_CLIENT_ID="replace-with-your-github-oauth-client-id"

# ✅ required at runtime - GitHub OAuth app client secret for Better Auth.
#    Build-time optional (see GITHUB_CLIENT_ID).
GITHUB_CLIENT_SECRET="replace-with-your-github-oauth-client-secret"

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=""

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS="false"

# ⚙️ optional - Shared secret for validating GitHub webhooks.
GITHUB_WEBHOOK_SECRET=""

# ⚙️ optional - Resend API key for sending transactional email. If unset, email delivery is skipped (with a warning) so local dev still works.
RESEND_API_KEY=""

# ⚙️ optional - From address used for outgoing transactional email. ex: "Portfolio <noreply@yourdomain.com>". Falls back to "noreply@example.com".
EMAIL_FROM=""

# ✅ required at runtime - OpenCode Go API key (LLM calls for the identity and portfolio agents).
#    Build-time optional (consumed via process.env).
#    Get one at https://opencode.ai/docs/zen — 13 models available.
OPENCODE_API_KEY="replace-with-your-opencode-api-key"

# ✅ required - OpenAI API key (for embeddings only; OpenCode Go does not provide embeddings).
OPENAI_API_KEY="replace-with-your-openai-api-key"

# ✅ required - Self-hosted Ollama server (used for embeddings).
# Leave OPENAI_API_KEY unset unless you want to use OpenAI for embeddings.
OLLAMA_BASE_URL="https://ollama.salahmohsen.com"

# ⚙️ optional - Embedding model used by the server.
EMBEDDING_MODEL=openai/text-embedding-3-small

# ⚙️ optional - Agent Worker URL — dev fallback when service binding is unavailable
AGENT_WORKER_URL="http://localhost:4111"

# ⚙️ optional - Turso (libSQL) database URL for Mastra agent storage.
#    Leave empty to use local file storage (file:./mastra.db).
TURSO_DATABASE_URL=""

# ⚙️ optional - Turso auth token. Required when TURSO_DATABASE_URL is set.
TURSO_AUTH_TOKEN=""

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""
