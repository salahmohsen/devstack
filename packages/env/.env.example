# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL="http://localhost:5000"

# ✅ required - Public URL of the web app.
VITE_WEB_URL="http://localhost:3000"

# ✅ required - Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# ✅ required - Secret key for Better Auth. Generate with: vp run auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# ✅ required - GitHub OAuth app client ID for Better Auth.
GITHUB_CLIENT_ID="replace-with-your-github-oauth-client-id"

# ✅ required - GitHub OAuth app client secret for Better Auth.
GITHUB_CLIENT_SECRET="replace-with-your-github-oauth-client-secret"

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=""

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS="false"

# ⚙️ optional - Shared secret for validating GitHub webhooks.
GITHUB_WEBHOOK_SECRET=""

# ⚙️ optional - Resend API key for sending transactional email. If unset, email delivery is skipped (with a warning) so local dev still works.
RESEND_API_KEY=""

# ⚙️ optional - From address used for outgoing transactional email. ex: "Portfolio <noreply@yourdomain.com>". Falls back to "noreply@example.com".
EMAIL_FROM=""

# ✅ required - OpenCode Go API key (LLM calls for the identity and portfolio agents).
#    Get one at https://opencode.ai/docs/zen — 13 models available.
OPENCODE_API_KEY="replace-with-your-opencode-api-key"

# ✅ required - OpenAI API key (for embeddings only; OpenCode Go does not provide embeddings).
OPENAI_API_KEY="replace-with-your-openai-api-key"

# ✅ required - Self-hosted Ollama server (used for embeddings).
# Leave OPENAI_API_KEY unset unless you want to use OpenAI for embeddings.
OLLAMA_BASE_URL="https://ollama.salahmohsen.com"

# ⚙️ optional - Embedding model used by Mastra memory (semantic recall + identity vectors).
#    OpenCode Go does not provide embeddings, so this defaults to OpenAI.
EMBEDDING_MODEL=openai/text-embedding-3-small

# ⚙️ optional - Default LLM for the identity and portfolio agents (OpenCode Go model).
#    See https://opencode.ai/docs/zen for the 13 available models.
#    Examples: opencode-go/qwen3.7-max (most capable), opencode-go/qwen3.7-plus (balanced),
#    opencode-go/kimi-k2.7-code (good for code), opencode-go/deepseek-v4-flash (fastest).
MASTRA_MODEL=opencode-go/qwen3.7-plus

# ⚙️ optional - Confidence floor for the refresh-identity workflow.
#    Below this threshold, facet proposals are queued for human review
#    instead of being written. Default 0 (auto-write everything).
MASTRA_IDENTITY_AUTO_WRITE_THRESHOLD=0

# ⚙️ optional - Comma-separated filenames the gather step fetches per repo.
#    Overrides the default list at module load; set to empty string to use
#    the hardcoded default.
MASTRA_GITHUB_FILE_GLOBS=README.md,AGENTS.md,CLAUDE.md,.cursorrules,.github/copilot-instructions.md,package.json

# ⚙️ optional - Dev-only: URL where the Mastra Studio UI is running. Added to
# CORS allowlist so the Studio can call the Mastra server's API.
MASTRA_STUDIO_URL=http://localhost:4111

# ⚙️ optional - Mastra Cloud platform access token. When set, the
# MastraPlatformExporter ships traces, logs, and metrics to the hosted
# observability surface (https://observability.mastra.ai). Leave unset for
# local-only — the MastraPlatformExporter auto-disables without a token.
MASTRA_PLATFORM_ACCESS_TOKEN=

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""
