{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-maia",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "styles/globals.css",
    "baseColor": "stone",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@tsu-stack/ui/components",
    "utils": "@tsu-stack/ui/lib/utils",
    "ui": "@tsu-stack/ui/components",
    "lib": "@tsu-stack/ui/lib",
    "hooks": "@tsu-stack/ui/hooks"
  },
  "registries": {
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@dotmatrix": "https://dotmatrix.zzzzshawn.cloud/r/{name}.json",
    "@hextaui": "https://hextaui.com/r/{name}.json",
    "@unlumen-ui": "https://ui.unlumen.com/r/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@cardcn": "https://cardcn.dev/r/{name}.json",
    "@skiper-ui": "https://skiper-ui.com/registry/{name}.json",
    "@cubby-ui": "https://www.cubby-ui.dev/r/{name}.json"
  }
