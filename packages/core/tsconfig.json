{
  // Relative path so Vite/oxc can load this config when other packages import core source.
  "extends": "../../tools/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2023.Array"],
    "paths": {
      "#@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
