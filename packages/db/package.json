{
  "name": "@tsu-stack/db",
  "private": true,
  "type": "module",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db": "pnpm dotenvx run -f ../env/.env -- drizzle-kit",
    "auth:generate": "vp run -w auth:generate",
    "db:setup": "vpx neon-new@latest --env ../../packages/env/.env --key DATABASE_URL --ref github:salahmohsen/portfolio --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@tsu-stack/logger": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-start": "catalog:"
  }
}
