{
  "name": "@tsu-stack/db",
  "private": true,
  "type": "module",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./repositories": "./src/repositories/index.ts",
    "./schema": "./src/schema/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "db": "dotenvx run -f ../env/.env -- drizzle-kit",
    "auth:generate": "dotenvx run -f ../env/.env -- npx auth@1.7.0-rc.1 generate --config ../auth/src/index.ts --output ./src/schema/auth.schema.ts --yes",
    "db:generate": "pnpm run db generate",
    "test:unit": "vp test run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-start": "catalog:"
  }
}
