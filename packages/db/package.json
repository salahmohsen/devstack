{
  "name": "@tsu-stack/db",
  "private": true,
  "type": "module",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./repositories": "./src/repositories/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db": "pnpm dotenvx run -f ../env/.env -- drizzle-kit",
    "auth:generate": "pnpm dotenvx run -f ../env/.env -- npx auth@latest generate --config ../auth/src/index.ts --output ./src/schema/auth.schema.ts --yes",
    "db:generate": "pnpm run db generate",
    "db:setup": "vpx neon-new@latest --env ../../packages/env/.env --key DATABASE_URL --ref github:salahmohsen/portfolio --yes"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-start": "catalog:"
  }
}
