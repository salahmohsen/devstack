{
  "name": "@tsu-stack/server",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cf-typegen": "wrangler types --config wrangler.dev.jsonc",
    "deploy": "pnpm dotenvx run -f ../../packages/env/.env -- cross-env CLOUDFLARE_INCLUDE_PROCESS_ENV=true wrangler deploy",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env -- cross-env CLOUDFLARE_INCLUDE_PROCESS_ENV=true VITE_SERVER_URL=http://localhost:5001/server VITE_WEB_URL=http://localhost:3000 wrangler dev --config wrangler.dev.jsonc --port 5001",
    "logs": "npx wrangler tail portfolio-server --format json"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tsu-stack/api": "workspace:*",
    "@tsu-stack/auth": "workspace:*",
    "@tsu-stack/db": "workspace:*",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/github": "workspace:*",
    "@tsu-stack/logger": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
