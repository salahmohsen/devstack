{
  "name": "@tsu-stack/server",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "cross-env IS_BUILD=true vp build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm dotenvx run -f ../../packages/env/.env -- wrangler deploy",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env -- cross-env CLOUDFLARE_INCLUDE_PROCESS_ENV=true vp dev"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tsu-stack/api": "workspace:*",
    "@tsu-stack/auth": "workspace:*",
    "@tsu-stack/db": "workspace:*",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/logger": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
