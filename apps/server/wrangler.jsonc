{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    // Enables the Node.js API subset/polyfills used by the Hono worker bundle.
    "nodejs_compat",
    // Suppresses warnings when Octokit's internal before-after-hook promises
    // resolve after the request context has been cleaned up. Octokit uses
    // async hooks that can outlive the request, which is harmless.
    "no_handle_cross_request_promise_resolution"
  ],
  "routes": [
    {
      "pattern": "salahmohsen.com/server*",
      "zone_name": "salahmohsen.com",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "main": "src/worker.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "VITE_SERVER_URL": "https://salahmohsen.com/server",
    "VITE_WEB_URL": "https://salahmohsen.com",
    "AGENT_WORKER_URL": "https://salahmohsen.com/agent"
  },
  "services": [
    {
      "binding": "AGENT_WORKER",
      "service": "devhub-agent"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GITHUB_CACHE_KV",
      "id": "24c38be634a943a9bcb47f9fd133fee6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "personal-hub"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GITHUB_SIGNAL_RELAY",
        "class_name": "GitHubSignalRelay"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["GitHubSignalRelay"],
      "tag": "v1"
    }
  ]
}
