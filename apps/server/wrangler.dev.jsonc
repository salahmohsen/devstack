{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    // Enables the Node.js API subset/polyfills used by the Hono worker bundle.
    "nodejs_compat",
    // Suppresses warnings when Octokit's internal before-after-hook promises
    // resolve after the request context has been cleaned up. Octokit uses
    // async hooks that can outlive the request, which is harmless.
    "no_handle_cross_request_promise_resolution"
  ],
  // No `routes` — they're a production-deploy concept. Miniflare (Vite dev
  // runtime) tries to parse the production route pattern as a URL and
  // throws `Invalid URL string`. See ADR-0014.
  // `migrations` is included (unlike the old comment claimed) — wrangler
  // warns at startup when a `durable_objects` binding is declared but
  // the migrations section is missing. Miniflare's local SQLite-DO
  // state is keyed by the migration tag, so a clean dev start applies
  // the v1 migration harmlessly; the previous error only fired on a
  // re-apply against an already-migrated class.
  "keep_vars": true,
  "main": "src/worker.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "VITE_SERVER_URL": "http://localhost:5001/server",
    "VITE_WEB_URL": "http://localhost:3000"
  },
  "kv_namespaces": [
    {
      "binding": "GITHUB_CACHE_KV",
      "id": "24c38be634a943a9bcb47f9fd133fee6"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GITHUB_SIGNAL_RELAY",
        "class_name": "GitHubSignalRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitHubSignalRelay"]
    }
  ]
}
