{
  "extends": "@tsu-stack/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],

      // for shadcn CLI to resolve @tsu-stack/ui
      "@tsu-stack/ui/*": ["../../packages/ui/*"]
    },
    "types": ["node", "vite/client", "mdx"],

    "allowJs": true,
    "lib": ["DOM", "ES2023", "ES2024", "ESNext"]
  },
  "mdx": {
    "checkMdx": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/ui/components/calendar-dropdown.tsx"],
  "exclude": ["node_modules"]
}
