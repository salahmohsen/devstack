{
  "extends": "@tsu-stack/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],

      // for shadcn CLI to resolve @tsu-stack/ui and @tsu-stack/icons paths
      "@tsu-stack/ui/*": ["../../packages/ui/*"],
      "@tsu-stack/icons": ["../../packages/icons/src/index.tsx"],
      "@tsu-stack/icons/*": ["../../packages/icons/*"]
    },
    "types": ["node", "vite/client", "mdx"],

    /* Because paraglide.js breaks types during rebuilds on dev */
    "allowJs": true,
    "lib": ["DOM", "ES2023", "ES2024", "ESNext"]
  },
  "mdx": {
    "checkMdx": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ui/components/team-switcher.tsx",
    "../../packages/ui/components/locale-switcher.tsx",
    "../../packages/ui/components/theme-switcher.tsx"
  ],
  "exclude": ["node_modules"]
}
