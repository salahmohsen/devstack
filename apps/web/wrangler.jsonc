{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    // Enables the Node.js API subset/polyfills used by the Vite + TanStack Start worker bundle.
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "salahmohsen.com/*",
      "zone_name": "salahmohsen.com"
    }
  ],
  "keep_vars": true,
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "VITE_SERVER_URL": "https://salahmohsen.com/server",
    "VITE_WEB_URL": "https://salahmohsen.com",
    "R2_PUBLIC_BASE_URL": "https://pub-a1ecba0fdfda4a279c58c304202f844f.r2.dev"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "personal-hub"
    }
  ]
}
