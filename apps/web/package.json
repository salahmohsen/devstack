{
  "name": "@tsu-stack/web",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "cf-typegen": "wrangler types",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env -- cross-env CLOUDFLARE_INCLUDE_PROCESS_ENV=true vp dev",
    "deploy": "pnpm dotenvx run -f ../../packages/env/.env -- cross-env CLOUDFLARE_INCLUDE_PROCESS_ENV=true wrangler deploy",
    "logs": "npx wrangler tail portfolio-web --format json",
    "preview": "pnpm dotenvx run -f ../../packages/env/.env -- vp preview",
    "start": "pnpm dotenvx run -f ../../packages/env/.env -- node .output/server/index.mjs",
    "ui": "vpx shadcn@latest"
  },
