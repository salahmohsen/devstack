{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-maia",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/shared/styles/app.css",
    "baseColor": "stone",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/shared/ui",
    "utils": "@tsu-stack/ui/lib/utils",
    "ui": "@tsu-stack/ui/components",
    "lib": "@tsu-stack/ui/lib",
    "hooks": "@tsu-stack/ui/hooks"
  },
  "registries": {
    "@unlumen-ui": "https://ui.unlumen.com/r/{name}.json",
    "@hextaui": "https://hextaui.com/r/{name}.json",
    "@files-sdk": "https://files-sdk.dev/r/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@reui": "https://reui.io/r/{name}.json",
    "@assistant-ui": "https://r.assistant-ui.com/styles/{style}/{name}.json",
    "@beui": "https://beui.dev/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}",
    "@ncdai": "https://chanhdai.com/r/{name}.json",
    "@efferd": "https://efferd.com/r/{style}/{name}.json"
  }
}
