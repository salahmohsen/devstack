{
  "name": "@tsu-stack/agent",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index"
  },
  "scripts": {
    "rebuild:core-cache": "pnpm exec esbuild ../../packages/core/src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=../../packages/core/node_modules/.cache/@tsu-stack__core.mjs --sourcemap",
    "rebuild:db-cache": "pnpm exec esbuild ../../packages/db/src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=../../packages/db/node_modules/.cache/@tsu-stack__db.mjs --sourcemap",
    "dev": "pnpm run rebuild:core-cache && pnpm run rebuild:db-cache && PORT=4111 dotenvx run -f ../../packages/env/.env -- mastra dev --inspect",
    "mastra:studio": "mastra studio --port 4112 --server-port 4111 --env ../../packages/env/.env",
    "build": "IS_BUILD=true mastra build",
    "start": "node .mastra/output/index.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test:unit": "vp test run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/auth-better-auth": "catalog:",
    "@mastra/core": "catalog:",
    "@mastra/duckdb": "catalog:",
    "@mastra/evals": "catalog:",
    "@mastra/loggers": "catalog:",
    "@mastra/memory": "catalog:",
    "@mastra/observability": "catalog:",
    "@mastra/pg": "catalog:",
    "@tsu-stack/core": "workspace:*",
    "@tsu-stack/db": "workspace:*",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/logger": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "files-sdk": "catalog:",
    "hono": "catalog:",
    "ollama-ai-provider-v2": "catalog:",
    "pdfnative": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "mastra": "catalog:",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:"
  }
}
