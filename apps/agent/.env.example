OPENAI_API_KEY=your-api-key

# Cloudflare — set these to use D1 for storage instead of local LibSQL
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_D1_DATABASE_ID=f9e4f357-f016-4be6-85f4-54beaa6c36de
CLOUDFLARE_D1_PREVIEW_DATABASE_ID=f9e4f357-f016-4be6-85f4-54beaa6c36de
CLOUDFLARE_KV_AGENT_CACHE_ID=d39dbbce5f874c9ebd9543a6de17b888

# Required when using D1 — set locally via `export CLOUDFLARE_D1_API_TOKEN=...`
# CLOUDFLARE_D1_API_TOKEN=
