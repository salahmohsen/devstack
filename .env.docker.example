# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL=http://localhost:5000

# ✅ required - Public URL of the web app.
VITE_WEB_URL=http://localhost:3000

# ✅ required - Secret key for Better Auth. Generate with: vp run auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# ✅ required - Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=

# ⚙️ optional - Host port for the web service.
WEB_PORT=3000

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS=false

# ⚙️ optional - Host port for the server service.
SERVER_PORT=5000

# ✅ required - OpenCode Go API key (LLM calls for the identity and portfolio agents).
#    Get one at https://opencode.ai/docs/zen — 13 models available.
OPENCODE_API_KEY="replace-with-your-opencode-api-key"

# ✅ required - OpenAI API key (for embeddings only; OpenCode Go does not provide embeddings).
OPENAI_API_KEY="replace-with-your-openai-api-key"

# ⚙️ optional - Embedding model used by Mastra memory (semantic recall + identity vectors).
#    OpenCode Go does not provide embeddings, so this defaults to OpenAI.
EMBEDDING_MODEL=openai/text-embedding-3-small

# ⚙️ optional - Default LLM for the identity and portfolio agents (OpenCode Go model).
#    See https://opencode.ai/docs/zen for the 13 available models.
MASTRA_MODEL=opencode-go/qwen3.7-plus

# ⚙️ optional - Confidence floor for the refresh-identity workflow.
#    Below this threshold, facet proposals are queued for human review
#    instead of being written. Default 0 (auto-write everything).
MASTRA_IDENTITY_AUTO_WRITE_THRESHOLD=0

# ⚙️ optional - Comma-separated filenames the gather step fetches per repo.
#    Leave empty to use the hardcoded default.
MASTRA_GITHUB_FILE_GLOBS=README.md,AGENTS.md,CLAUDE.md,.cursorrules,.github/copilot-instructions.md,package.json
